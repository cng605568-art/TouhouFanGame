# TODO: Translation updated at 2026-11-28 07:05

# game/case07.rpy:60
translate japanese press_alice_1_56e5a90f:

    # you "How did she get in?"
    you "彼女はどうやって入ったのですか？"

# game/case07.rpy:61
translate japanese press_alice_1_9663285e:

    # alice "Through the window. She has never once used a door."
    alice "窓からよ。あの子は一度もドアを使ったことがないの。"

# game/case07.rpy:63
translate japanese press_alice_1_dc9e6e55:

    # eiki "A pattern is emerging."
    eiki "傾向が見えてきましたね。"

# game/case07.rpy:67
translate japanese press_alice_2_caec51e3:

    # you "What was the comment, exactly?"
    you "その感想とは、具体的に何ですか？"

# game/case07.rpy:69
translate japanese press_alice_2_9641f26c:

    # alice "Something rude. The details don't matter."
    alice "失礼なことよ。細かいことはどうでもいいわ。"

# game/case07.rpy:71
translate japanese press_alice_2_e220c05f:

    # eiki "The details are the entire case."
    eiki "細かいことこそが、この事件のすべてです。"

# game/case07.rpy:75
translate japanese press_alice_3_a5c3768a:

    # you "Defended it from what?"
    you "何から守ったのですか？"

# game/case07.rpy:76
translate japanese press_alice_3_a465442d:

    # alice "From her insult, obviously. Put this in my testimony. Word for word."
    alice "あの子の侮辱からに決まってるでしょ。証言に加えて。一字一句そのままで。"

# game/case07.rpy:80
translate japanese press_alice_4_29dfe6a2:

    # you "Are those her exact words? \"Worthless junk\"?"
    you "それは彼女の言葉そのままですか？「価値のないガラクタ」と？"

# game/case07.rpy:82
translate japanese press_alice_4_2a78c31f:

    # alice "Close enough. It's what she meant. I could tell by her face."
    alice "だいたいそうよ。そういう意味だったの。顔を見ればわかるわ。"

# game/case07.rpy:84
translate japanese press_alice_4_adbc380a:

    # eiki "A face is not a quote."
    eiki "顔は引用ではありません。"

# game/case07.rpy:95
translate japanese case7_3af4f096:

    # eiki "Order. The Higan Court of Logic is in session."
    eiki "静粛に。彼岸論理法廷を開廷します。"

# game/case07.rpy:97
translate japanese case7_b506956e:

    # eiki "Komachi. The defendant?"
    eiki "小町。被告人は？"

# game/case07.rpy:98
translate japanese case7_7452aaf8:

    # komachi "Here, boss. She brought a lawyer."
    komachi "連れてきましたよ、四季様。弁護士同伴です。"

# game/case07.rpy:99
translate japanese case7_044329bf:

    # eiki "This court does not allow—"
    eiki "当法廷では認められて——"

# game/case07.rpy:100
translate japanese case7_fd065541:

    # komachi "It's a doll, boss. It's very quiet."
    komachi "人形ですよ、四季様。とても静かです。"

# game/case07.rpy:103
translate japanese case7_27484148:

    # alice "Alice Margatroid, puppeteer of the Forest of Magic. I'll be brief. I had every right."
    alice "魔法の森の人形遣い、アリス・マーガトロイド。手短に言うわ。私には正当な理由があった。"

# game/case07.rpy:106
translate japanese case7_6f6eb84d:

    # eiki "The charge: tying Kirisame Marisa to a tree with doll string. For six hours."
    eiki "罪状：人形の糸で霧雨魔理沙を木に縛りつけたこと。六時間。"

# game/case07.rpy:110
translate japanese case7_a6f83d57:

    # alice "Seven. She wriggled."
    alice "七時間よ。暴れたから。"

# game/case07.rpy:114
translate japanese case7_d515cc3d:

    # eiki "Junior Judge. Before you weigh an argument, make sure it is the one actually made."
    eiki "見習い判事。議論を量る前に、それが実際になされた議論か確かめなさい。"

# game/case07.rpy:115
translate japanese case7_968c1297:

    # eiki "Anyone can knock down a scarecrow. Check that it isn't one."
    eiki "かかしなら誰でも倒せます。それがかかしでないか確かめなさい。"

# game/case07.rpy:131
translate japanese case7_dd8bf47c:

    # alice_t "Yesterday Marisa came to my house. Uninvited, as always."
    alice_t "昨日、魔理沙がうちに来たの。いつも通り、招かれもせずに。"

# game/case07.rpy:132
translate japanese case7_fde9563a:

    # alice_t "She looked at my newest doll and made a comment about it."
    alice_t "あの子は私の最新作の人形を見て、感想を言ったの。"

# game/case07.rpy:133
translate japanese case7_373ff126:

    # alice_t "So I defended my life's work. Anyone would have."
    alice_t "だから私は自分の生涯の作品を守ったの。誰だってそうするわ。"

# game/case07.rpy:137
translate japanese case7_d3c9298c:

    # eiki "The floor is yours, Junior Judge. Mind the strings."
    eiki "見習い判事、お任せします。糸に気をつけて。"

# game/case07.rpy:151
translate japanese case7_cross_91432a3d:

    # eiki "Again. And Komachi, give the lawyer back."
    eiki "もう一度。それと小町、弁護士を返しなさい。"

# game/case07.rpy:162
translate japanese case7_breakthrough_9ee5cbab:

    # you "Marisa never called your dolls junk. She said they're really good, and take forever to make."
    you "魔理沙はあなたの人形をガラクタとは言っていません。すごく良いけど作るのに時間がかかる、と言ったのです。"

# game/case07.rpy:163
translate japanese case7_breakthrough_6185b8ed:

    # you "You argued against the insult you imagined, not the comment she made."
    you "あなたが反論したのは、彼女の感想ではなく、あなたが想像した侮辱です。"

# game/case07.rpy:166
translate japanese case7_breakthrough_2895e2c8:

    # alice "...She said they were really good? In the newspaper? In print?"
    alice "……すごく良いって言ったの？新聞で？活字で？"

# game/case07.rpy:170
translate japanese case7_breakthrough_cf12b169:

    # eiki "A straw man. Rebuild someone's words into something weaker, then knock that down instead."
    eiki "わら人形論法。相手の言葉をもっと弱いものに作り替え、それを倒すことです。"

# game/case07.rpy:171
translate japanese case7_breakthrough_a6ab13e4:

    # eiki "Answer what was said. Not what you wish had been said."
    eiki "言われたことに答えなさい。言われてほしかったことにではなく。"

# game/case07.rpy:178
translate japanese case7_breakthrough_bfc29046:

    # eiki "Defendant Alice Margatroid. This court finds you..."
    eiki "被告人、アリス・マーガトロイド。当法廷はあなたを……"

# game/case07.rpy:189
translate japanese case7_breakthrough_ecd26d99:

    # eiki "Sentence: untie Marisa. Then apologise. In person."
    eiki "判決：魔理沙をほどくこと。そして謝ること。直接会って。"

# game/case07.rpy:192
translate japanese case7_breakthrough_8240e028:

    # alice "...She's still tied to the tree?"
    alice "……まだ木に縛られているのですか？"

# game/case07.rpy:195
translate japanese case7_breakthrough_b0bb663a:

    # komachi "Since yesterday, boss. She asked me to bring snacks."
    komachi "昨日からですよ、四季様。おやつを持ってきてって頼まれました。"

# game/case07.rpy:196
translate japanese case7_breakthrough_ce35d871:

    # eiki "Then bring snacks. And escort the defendant to the tree. Bailiff."
    eiki "では、おやつを持っていきなさい。被告人を木まで連れていくように。廷吏。"

# game/case07.rpy:197
translate japanese case7_breakthrough_ce8461be:

    # komachi "On it, boss."
    komachi "はいよ、四季様。"

# game/case07.rpy:209
translate japanese case7_breakthrough_1d8bb793:

    # eiki "Court is adjourned. Someone take that magician a sandwich."
    eiki "閉廷します。誰か、あの魔法使いにサンドイッチを。"

# game/case07.rpy:210
translate japanese case7_breakthrough_3948a694:

    # komachi "Already packed two, boss. One's for me."
    komachi "もう二つ包みました、四季様。一つは私の分です。"

