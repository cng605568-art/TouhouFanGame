# game/script.rpy:274
translate japanese press_cirno_1_ebfd0569:

    # you "Twenty exactly? How did you count them?"
    you "ちょうど二十匹？どうやって数えた？"

# game/script.rpy:276
translate japanese press_cirno_1_d8481f30:

    # cirno "On my fingers! I ran out, so I counted my fingers again."
    cirno "指で！足りなくなったから、もう一回指で数えた！"

# game/script.rpy:278
translate japanese press_cirno_1_3a294f25:

    # eiki "...That is correct arithmetic. I am as surprised as you are."
    eiki "……計算は合っています。私もあなたと同じくらい驚いています。"

# game/script.rpy:282
translate japanese press_cirno_2_90aff685:

    # you "What was the weather like at noon?"
    you "昼の天気はどうだった？"

# game/script.rpy:283
translate japanese press_cirno_2_86fca187:

    # cirno "Hot! The sun was showing off all day. Rude, honestly."
    cirno "暑かった！太陽が一日中いばってた。ほんと失礼だよね。"

# game/script.rpy:285
translate japanese press_cirno_2_343a4f41:

    # cirno "Stop changing the subject. The subject is me being amazing."
    cirno "話をそらすな。今はあたいがすごいって話をしてるんだ。"

# game/script.rpy:289
translate japanese press_cirno_3_73611140:

    # you "How exactly does freezing make a frog immortal?"
    you "凍らせると、どうしてカエルが不死身になる？"

# game/script.rpy:290
translate japanese press_cirno_3_f40db3d0:

    # cirno "Easy! First, ice. Then, frog is alive. So the ice did the alive part!"
    cirno "簡単だよ！まず、氷。それから、カエルが生きてる。だから氷が生かしたんだ！"

# game/script.rpy:292
translate japanese press_cirno_3_0c4fe4ce:

    # cirno "That's called science. I'm basically a scientist. A cold one."
    cirno "それを科学って言うんだ。あたいはほぼ科学者。冷たいやつ。"

# game/script.rpy:294
translate japanese press_cirno_3_cfa27486:

    # eiki "Her entire argument is balanced on the word \"then.\""
    eiki "彼女の論証は全部、「それから」という一語の上に乗っています。"

# game/script.rpy:313
translate japanese case1_b34914f1:

    # eiki "Order. The Higan Court of Logic is now in session."
    eiki "静粛に。彼岸論理法廷を開廷します。"

# game/script.rpy:315
translate japanese case1_8eeb8c03:

    # eiki "Komachi. Bring in the defendant."
    eiki "小町。被告人を連れてきなさい。"

# game/script.rpy:316
translate japanese case1_ec5858db:

    # komachi "She's already here, boss. Tried to freeze the bailiff on the way in."
    komachi "もう来てますよ、四季様。入ってくる途中で廷吏を凍らせようとしました。"

# game/script.rpy:317
translate japanese case1_5dfe3f51:

    # eiki "You are the bailiff."
    eiki "あなたが廷吏でしょう。"

# game/script.rpy:318
translate japanese case1_fb7ff126:

    # komachi "Yep. Little chilly."
    komachi "ええ。ちょっと寒いです。"

# game/script.rpy:319
translate japanese case1_4de91353:

    # eiki "Junior Judge, you will cross-examine today. Try not to embarrass the Ministry."
    eiki "見習い判事、今日はあなたが反対尋問を行います。是非曲直庁に恥をかかせないように。"

# game/script.rpy:322
translate japanese case1_11a2af97:

    # cirno "I'm Cirno! Strongest fairy in Gensokyo! Do I win now?"
    cirno "あたいはチルノ！幻想郷最強の妖精！もう勝ちでいい？"

# game/script.rpy:325
translate japanese case1_2cf64c85:

    # eiki "The charge: unlicensed refrigeration of twenty frogs at Misty Lake."
    eiki "罪状：霧の湖におけるカエル二十匹の無許可冷凍。"

# game/script.rpy:326
translate japanese case1_2f2d1151:

    # eiki "Defendant. How do you plead?"
    eiki "被告人。罪を認めますか？"

# game/script.rpy:329
translate japanese case1_c7fe0f9d:

    # cirno "Super innocent! Also, you're welcome."
    cirno "超無罪！あと、どういたしまして。"

# game/script.rpy:333
translate japanese case1_e4d0793d:

    # eiki "Listen well, Junior Judge. A liar is easy to catch."
    eiki "よく聞きなさい、見習い判事。嘘つきは簡単に捕まります。"

# game/script.rpy:334
translate japanese case1_d850c3b6:

    # eiki "Bad logic is slipperier. It hides between true facts and dresses up as common sense."
    eiki "誤った論理はもっと捕まえにくい。正しい事実の間に隠れ、常識の顔をしています。"

# game/script.rpy:335
translate japanese case1_2c8d9212:

    # eiki "Find the step that doesn't follow. Then object, and name the fallacy."
    eiki "つながらない一歩を見つけなさい。そして異議を唱え、誤謬の名を言いなさい。"

# game/script.rpy:337
translate japanese case1_8dca40f9:

    # eiki "Then prove it. Everything this court knows sits in the Court Record."
    eiki "そして証明しなさい。当法廷が知ることはすべて法廷記録にあります。"

# game/script.rpy:353
translate japanese case1_1718a3b0:

    # cirno_t "I froze twenty frogs by Misty Lake this morning!"
    cirno_t "今朝、霧の湖でカエルを二十匹凍らせた！"

# game/script.rpy:354
translate japanese case1_35fc94fc:

    # cirno_t "Every single one of them thawed out by noon and hopped away!"
    cirno_t "一匹残らず、昼までに解けてぴょんぴょん逃げていった！"

# game/script.rpy:355
translate japanese case1_39cc2c54:

    # cirno_t "Therefore, freezing frogs makes them immortal! I'm basically a lifesaver!"
    cirno_t "だから、凍らせるとカエルは不死身になる！あたいは命の恩人ってこと！"

# game/script.rpy:359
translate japanese case1_b156934a:

    # eiki "The floor is yours, Junior Judge. Press her for details."
    eiki "どうぞ、見習い判事。彼女を揺さぶって詳しく聞きなさい。"

# game/script.rpy:360
translate japanese case1_56bac375:

    # eiki "When a statement fails, object. You have [spirit_word!t] magatama of spirit. Spend them wisely."
    eiki "発言が破綻したら異議を。霊力の勾玉は[spirit_word!t]つ。大事に使いなさい。"

# game/script.rpy:374
translate japanese case1_cross_2726332a:

    # eiki "Again. From the top. Slower, for everyone's sake."
    eiki "もう一度。最初から。皆のために、ゆっくりと。"

# game/script.rpy:385
translate japanese case1_breakthrough_00d679e4:

    # you "Plenty of frogs freeze in winter and thaw in spring. They manage it without you."
    you "冬に凍って春に解けるカエルはたくさんいる。お前がいなくても、ちゃんとそうなる。"

# game/script.rpy:386
translate japanese case1_breakthrough_f69b5607:

    # you "The ice didn't save them. The noon sun thawed them. You just happened to be first."
    you "氷が救ったんじゃない。昼の太陽が解かしたんだ。お前はたまたま先だっただけだ。"

# game/script.rpy:389
translate japanese case1_breakthrough_114e8904:

    # cirno "B-but the ice came first! First means it did it!"
    cirno "で、でも氷が先だったもん！先ってことは、氷がやったんだ！"

# game/script.rpy:393
translate japanese case1_breakthrough_adeb5213:

    # eiki "Post hoc, ergo propter hoc. \"After this, therefore because of this.\""
    eiki "ポスト・ホック・エルゴ・プロプテル・ホック。「この後に、ゆえにこのために」。"

# game/script.rpy:394
translate japanese case1_breakthrough_7f1940e4:

    # eiki "Two events line up in time, and you crown the first one the cause."
    eiki "二つの出来事が時間的に並ぶと、先のほうを原因にしてしまう。"

# game/script.rpy:395
translate japanese case1_breakthrough_bed96fcf:

    # eiki "The rooster crows, then the sun rises. Nobody thanks the rooster."
    eiki "鶏が鳴き、日が昇る。誰も鶏に感謝はしません。"

# game/script.rpy:402
translate japanese case1_breakthrough_b3416c7f:

    # eiki "Defendant Cirno. This court finds you..."
    eiki "被告人チルノ。当法廷はあなたに……"

# game/script.rpy:413
translate japanese case1_breakthrough_12f0faee:

    # eiki "Sentence: one hundred hours explaining causation to the frogs."
    eiki "判決：カエルたちに因果関係を百時間かけて説明すること。"

# game/script.rpy:416
translate japanese case1_breakthrough_7988cf39:

    # cirno "Can I freeze them while I explain?"
    cirno "説明しながら凍らせてもいい？"

# game/script.rpy:419
translate japanese case1_breakthrough_6063f5e0:

    # eiki "Bailiff."
    eiki "廷吏。"

# game/script.rpy:420
translate japanese case1_breakthrough_ce8461be:

    # komachi "On it, boss."
    komachi "はいよ、四季様。"

# game/script.rpy:432
translate japanese case1_breakthrough_18f47a5b:

    # eiki "...I said escort."
    eiki "……護送と言ったのです。"

# game/script.rpy:433
translate japanese case1_breakthrough_8b477ea6:

    # komachi "She's escorted. Very far."
    komachi "護送しましたよ。とても遠くまで。"

# game/script.rpy:434
translate japanese case1_breakthrough_8d952d11:

    # eiki "Court is adjourned. Adequate work, Junior Judge."
    eiki "閉廷します。まずまずの仕事でした、見習い判事。"

