# game/case10.rpy:62
translate japanese mokou_flare_2a7742da:

    # komachi "[flare!t]"
    komachi "[flare!t]"

# game/case10.rpy:67
translate japanese press_mokou_1_431a8d2d:

    # you "Hardly struggled?"
    you "ほとんど抵抗しなかった？"

# game/case10.rpy:69
translate japanese press_mokou_1_5fd43467:

    # mokou "She laughed the whole way. Then she handed me this."
    mokou "ずっと笑ってたよ。それから、これを渡された。"

# game/case10.rpy:72
translate japanese press_mokou_1_6560db77:

    # eiki "...Laughed."
    eiki "……笑っていた。"

# game/case10.rpy:76
translate japanese press_mokou_2_585f0b40:

    # you "What does a thousand-year-old feud have to do with yesterday?"
    you "千年前の確執が、昨日のことと何の関係があるのですか？"

# game/case10.rpy:78
translate japanese press_mokou_2_24fa6820:

    # mokou "Everything! ...Mostly. Some of it."
    mokou "全部だよ！……だいたい。一部は。"

# game/case10.rpy:80
translate japanese press_mokou_2_a72bf289:

    # eiki "None of it."
    eiki "何も関係ありません。"

# game/case10.rpy:88
translate japanese case10_e4d50492:

    # komachi "Boss. They're back. Both of them. It's dinner time."
    komachi "四季様。戻ってきましたよ。二人とも。夕食時です。"

# game/case10.rpy:89
translate japanese case10_82fc8a19:

    # eiki "As predicted."
    eiki "予想通りです。"

# game/case10.rpy:93
translate japanese case10_cf5069c6:

    # eiki "A short session. The charge is kidnapping, and the defendant is hungry."
    eiki "短い審理です。罪状は誘拐、そして被告人は空腹です。"

# game/case10.rpy:97
translate japanese case10_82118b5e:

    # mokou "Fujiwara no Mokou. Let's make it quick. There's a pot of dishes waiting for somebody."
    mokou "藤原妹紅だ。さっさと済ませよう。誰かを皿洗いの山が待ってるんでね。"

# game/case10.rpy:100
translate japanese case10_82384f8f:

    # eiki "The charge: carrying the defendant of Case 09 out of this court. By force. On fire."
    eiki "罪状：第九の事件の被告人を、この法廷から連れ出したこと。力ずくで。燃えながら。"

# game/case10.rpy:101
translate japanese case10_a225a076:

    # kaguya "I'm a witness too, you know. Nobody asked me."
    kaguya "私も証人なのよ。誰も聞いてくれないけど。"

# game/case10.rpy:102
translate japanese case10_a5ce8077:

    # eiki "Later."
    eiki "後にしなさい。"

# game/case10.rpy:105
translate japanese case10_9fda1bf8:

    # eiki "Junior Judge. A bad argument is not the same as a false conclusion."
    eiki "見習い判事。悪い論証は、偽りの結論と同じではありません。"

# game/case10.rpy:106
translate japanese case10_0d0ea5e6:

    # eiki "Today, catch the fallacy. Then ask whether the answer was right anyway."
    eiki "今日は誤謬を見破りなさい。そして、それでも答えが正しかったのかを問いなさい。"

# game/case10.rpy:122
translate japanese case10_8e41f65c:

    # mokou_t "Kidnapping? I carried her out the door. She hardly struggled."
    mokou_t "誘拐？戸口から担いで出ただけだ。ほとんど抵抗もしなかったぞ。"

# game/case10.rpy:123
translate japanese case10_a1aec528:

    # mokou_t "And what about what her family did to mine, a thousand years ago? Ask about that."
    mokou_t "それより、千年前にあいつの家がうちにしたことはどうなんだ？それを聞けよ。"

# game/case10.rpy:127
translate japanese case10_9c2fe25a:

    # eiki "Quickly, Junior Judge. Before she sets anything else alight."
    eiki "急いでください、見習い判事。彼女がほかの物に火をつける前に。"

# game/case10.rpy:141
translate japanese case10_cross_511a86a4:

    # eiki "Again. Komachi, fetch a bucket."
    eiki "もう一度。小町、バケツを持ってきなさい。"

# game/case10.rpy:152
translate japanese case10_breakthrough_a7985c01:

    # you "A thousand-year-old feud says nothing about yesterday. That's a red herring."
    you "千年前の確執は、昨日のことについて何も語りません。それは燻製ニシンの虚偽です。"

# game/case10.rpy:153
translate japanese case10_breakthrough_7fd59251:

    # you "But this letter answers the question you dodged. Kaguya asked you to come and get her."
    you "でもこの手紙が、あなたがはぐらかした問いに答えています。輝夜があなたに迎えを頼んだのです。"

# game/case10.rpy:156
translate japanese case10_breakthrough_7fcb90a2:

    # mokou "...You read her letter? Out loud? In court?"
    mokou "……あいつの手紙を読んだのか？声に出して？法廷で？"

# game/case10.rpy:160
translate japanese case10_breakthrough_7df6c67b:

    # eiki "A red herring. Drag a smelly fish across the trail, and the hounds forget the fox."
    eiki "燻製ニシンの虚偽。臭い魚を足跡の上で引きずれば、猟犬は狐を忘れます。"

# game/case10.rpy:161
translate japanese case10_breakthrough_4cacd0f7:

    # eiki "Her reasoning was a red herring. Her conclusion, however, was correct."
    eiki "彼女の論証は燻製ニシンでした。しかし、彼女の結論は正しかったのです。"

# game/case10.rpy:162
translate japanese case10_breakthrough_fc11740a:

    # eiki "No one can kidnap a princess who wrote the invitation."
    eiki "招待状を書いた姫を、誘拐することはできません。"

# game/case10.rpy:169
translate japanese case10_breakthrough_5cb747ef:

    # eiki "Defendant Fujiwara no Mokou. On the charge of kidnapping, this court finds you..."
    eiki "被告人、藤原妹紅。誘拐の罪について、当法廷はあなたを……"

# game/case10.rpy:180
translate japanese case10_breakthrough_2f245723:

    # eiki "On the matter of the bench, however: you will build this court a new one."
    eiki "ただし証言台の件については、この法廷に新しいものを作ってもらいます。"

# game/case10.rpy:183
translate japanese case10_breakthrough_604c2a11:

    # mokou "Fine. I'm good with wood. Better with fire."
    mokou "いいよ。木工は得意だ。火の方がもっと得意だけどな。"

# game/case10.rpy:187
translate japanese case10_breakthrough_d32aabaa:

    # kaguya "For the record, I won. She's doing the dishes."
    kaguya "念のため言っておくけど、勝ったのは私よ。皿洗いはこの子。"

# game/case10.rpy:188
translate japanese case10_breakthrough_b6692432:

    # mokou "You did NOT win."
    mokou "お前は勝ってない！"

# game/case10.rpy:191
translate japanese case10_breakthrough_cc352d5c:

    # komachi "Bailiff time, boss? ...Wait. She was acquitted."
    komachi "廷吏の出番ですか、四季様？……あれ。無罪でしたね。"

# game/case10.rpy:192
translate japanese case10_breakthrough_c0fbcb37:

    # eiki "She was."
    eiki "そうです。"

# game/case10.rpy:193
translate japanese case10_breakthrough_0ba44c4b:

    # komachi "Can I throw someone anyway? It's a habit."
    komachi "それでも誰か投げていいですか？癖なんです。"

# game/case10.rpy:194
translate japanese case10_breakthrough_6d40e61c:

    # eiki "No."
    eiki "いけません。"

# game/case10.rpy:196
translate japanese case10_breakthrough_4b58e218:

    # komachi "Boss. The Bunbunmaru printed this before the trial even started."
    komachi "四季様。文々。新聞が、裁判が始まる前にこれを刷ってました。"

# game/case10.rpy:197
translate japanese case10_breakthrough_81c6b336:

    # eiki "\"PRINCESS KIDNAPPED IN COURT.\" One blurry photo, and not one word from the princess."
    eiki "「法廷で姫が誘拐」。ぼやけた写真が一枚、そして姫の言葉は一言もない。"

# game/case10.rpy:198
translate japanese case10_breakthrough_1ea22463:

    # eiki "That tengu has written about every case on this docket."
    eiki "あの天狗は、この事件記録のすべての事件について書いています。"

# game/case10.rpy:199
translate japanese case10_breakthrough_100a0b7e:

    # eiki "Komachi. Summon her. Tomorrow, she writes from the witness stand."
    eiki "小町。彼女を召喚しなさい。明日は、証言台から書いてもらいます。"

# game/case10.rpy:200
translate japanese case10_breakthrough_ce8461be:

    # komachi "On it, boss."
    komachi "はいよ、四季様。"

translate japanese strings:

    # game/case10.rpy:11
    old "Scorched Bench"
    new "焦げた証言台"

    # game/case10.rpy:11
    old "The witness bench from Case 09. Still smoking. Smells faintly of bamboo."
    new "第九の事件の証言台。まだ煙が出ている。かすかに竹の匂い。"

    # game/case10.rpy:13
    old "Bunbunmaru Extra"
    new "文々。新聞号外"

    # game/case10.rpy:13
    old "\"PRINCESS KIDNAPPED IN COURT!\" One blurry photo. Printed before it happened."
    new "「法廷で姫が誘拐！」ぼやけた写真が一枚。事件の前に印刷された。"

    # game/case10.rpy:15
    old "Kaguya's Letter"
    new "輝夜の手紙"

    # game/case10.rpy:15
    old "\"Mokou: come and get me after my trial. Loser does the dishes. —K\""
    new "「妹紅へ：裁判が終わったら迎えに来なさい。負けた方が皿洗い。——輝夜」"

    # game/case10.rpy:18
    old "Custody"
    new "身柄引き取り"

    # game/case10.rpy:18
    old "Kidnapping? I carried her out the door. She hardly struggled."
    new "誘拐？戸口から担いで出ただけだ。ほとんど抵抗もしなかったぞ。"

    # game/case10.rpy:18
    old "Carrying someone out is the charge, not a fallacy. Find where she argues."
    new "担いで出たことは罪状であって、誤謬ではありません。彼女が論じている箇所を探しなさい。"

    # game/case10.rpy:18
    old "And what about what her family did to mine, a thousand years ago? Ask about that."
    new "それより、千年前にあいつの家がうちにしたことはどうなんだ？それを聞けよ。"

    # game/case10.rpy:18
    old "Close. But she isn't saying Kaguya does it too. She's leaving the question behind entirely."
    new "惜しい。でも輝夜もやっているとは言っていません。問いそのものを置き去りにしているのです。"

    # game/case10.rpy:18
    old "She isn't attacking Kaguya to refute a claim. She's leading the court away from the question."
    new "主張を退けるために輝夜を攻撃しているのではありません。法廷を問いから遠ざけているのです。"

    # game/case10.rpy:18
    old "Nobody's words are twisted. The question is simply abandoned."
    new "誰の言葉も歪められていません。問いがただ放り出されているのです。"

    # game/case10.rpy:18
    old "No either-or. Just a thousand-year-old fish, dragged across the trail."
    new "二者択一はありません。千年物の魚が、足跡の上を引きずられているだけです。"

    # game/case10.rpy:18
    old "No circle. Her answer is about something else altogether."
    new "循環ではありません。彼女の答えは、まったく別の事についてです。"

    # game/case10.rpy:18
    old "That doesn't answer the question she dodged. Did Kaguya go against her will?"
    new "それでは彼女がはぐらかした問いに答えていません。輝夜は意に反して連れ去られたのですか？"

    # game/case10.rpy:49
    old "Boss, the bench is on fire again."
    new "四季様、また証言台が燃えてます。"

    # game/case10.rpy:49
    old "That was the railing, boss. Was."
    new "今のは手すりでした、四季様。でした。"

    # game/case10.rpy:49
    old "Boss, your hat is fine. Mostly."
    new "四季様、帽子は無事です。だいたいは。"

