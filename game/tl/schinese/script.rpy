# game/script.rpy:274
translate schinese press_cirno_1_ebfd0569:

    # you "Twenty exactly? How did you count them?"
    you "正好二十只？你怎么数的？"

# game/script.rpy:276
translate schinese press_cirno_1_d8481f30:

    # cirno "On my fingers! I ran out, so I counted my fingers again."
    cirno "用手指！不够用了，就再用手指数一遍！"

# game/script.rpy:278
translate schinese press_cirno_1_3a294f25:

    # eiki "...That is correct arithmetic. I am as surprised as you are."
    eiki "……算术是对的。我和你一样惊讶。"

# game/script.rpy:282
translate schinese press_cirno_2_90aff685:

    # you "What was the weather like at noon?"
    you "中午的天气怎么样？"

# game/script.rpy:283
translate schinese press_cirno_2_86fca187:

    # cirno "Hot! The sun was showing off all day. Rude, honestly."
    cirno "很热！太阳一整天都在炫耀。真没礼貌。"

# game/script.rpy:285
translate schinese press_cirno_2_343a4f41:

    # cirno "Stop changing the subject. The subject is me being amazing."
    cirno "别岔开话题。现在说的是我有多厉害。"

# game/script.rpy:289
translate schinese press_cirno_3_73611140:

    # you "How exactly does freezing make a frog immortal?"
    you "冻起来怎么就能让青蛙长生不死？"

# game/script.rpy:290
translate schinese press_cirno_3_f40db3d0:

    # cirno "Easy! First, ice. Then, frog is alive. So the ice did the alive part!"
    cirno "简单！先是冰，然后青蛙活着。所以是冰让它活的！"

# game/script.rpy:292
translate schinese press_cirno_3_0c4fe4ce:

    # cirno "That's called science. I'm basically a scientist. A cold one."
    cirno "这就叫科学。我差不多就是科学家。冷冰冰的那种。"

# game/script.rpy:294
translate schinese press_cirno_3_cfa27486:

    # eiki "Her entire argument is balanced on the word \"then.\""
    eiki "她的整个论证都架在“然后”这两个字上。"

# game/script.rpy:313
translate schinese case1_b34914f1:

    # eiki "Order. The Higan Court of Logic is now in session."
    eiki "肃静。彼岸逻辑法庭现在开庭。"

# game/script.rpy:315
translate schinese case1_8eeb8c03:

    # eiki "Komachi. Bring in the defendant."
    eiki "小町。带被告上来。"

# game/script.rpy:316
translate schinese case1_ec5858db:

    # komachi "She's already here, boss. Tried to freeze the bailiff on the way in."
    komachi "她已经到了，四季大人。进来的路上还想冻住法警。"

# game/script.rpy:317
translate schinese case1_5dfe3f51:

    # eiki "You are the bailiff."
    eiki "法警就是你。"

# game/script.rpy:318
translate schinese case1_fb7ff126:

    # komachi "Yep. Little chilly."
    komachi "是啊。有点冷。"

# game/script.rpy:319
translate schinese case1_4de91353:

    # eiki "Junior Judge, you will cross-examine today. Try not to embarrass the Ministry."
    eiki "见习法官，今天由你进行交叉询问。别给是非曲直厅丢脸。"

# game/script.rpy:322
translate schinese case1_11a2af97:

    # cirno "I'm Cirno! Strongest fairy in Gensokyo! Do I win now?"
    cirno "我是琪露诺！幻想乡最强的妖精！我现在赢了吗？"

# game/script.rpy:325
translate schinese case1_2cf64c85:

    # eiki "The charge: unlicensed refrigeration of twenty frogs at Misty Lake."
    eiki "罪名：在雾之湖无证冷冻二十只青蛙。"

# game/script.rpy:326
translate schinese case1_2f2d1151:

    # eiki "Defendant. How do you plead?"
    eiki "被告。你认罪吗？"

# game/script.rpy:329
translate schinese case1_c7fe0f9d:

    # cirno "Super innocent! Also, you're welcome."
    cirno "超级无罪！还有，不用谢。"

# game/script.rpy:333
translate schinese case1_e4d0793d:

    # eiki "Listen well, Junior Judge. A liar is easy to catch."
    eiki "听好了，见习法官。说谎的人很容易抓住。"

# game/script.rpy:334
translate schinese case1_d850c3b6:

    # eiki "Bad logic is slipperier. It hides between true facts and dresses up as common sense."
    eiki "错误的逻辑更滑溜。它藏在真实的事实之间，打扮成常识。"

# game/script.rpy:335
translate schinese case1_2c8d9212:

    # eiki "Find the step that doesn't follow. Then object, and name the fallacy."
    eiki "找出推不过去的那一步。然后提出异议，说出谬误的名字。"

# game/script.rpy:337
translate schinese case1_8dca40f9:

    # eiki "Then prove it. Everything this court knows sits in the Court Record."
    eiki "然后证明它。本庭知道的一切都在法庭记录里。"

# game/script.rpy:353
translate schinese case1_1718a3b0:

    # cirno_t "I froze twenty frogs by Misty Lake this morning!"
    cirno_t "今天早上，我在雾之湖冻住了二十只青蛙！"

# game/script.rpy:354
translate schinese case1_35fc94fc:

    # cirno_t "Every single one of them thawed out by noon and hopped away!"
    cirno_t "每一只到中午都解冻了，蹦蹦跳跳地跑掉了！"

# game/script.rpy:355
translate schinese case1_39cc2c54:

    # cirno_t "Therefore, freezing frogs makes them immortal! I'm basically a lifesaver!"
    cirno_t "所以，冻住青蛙能让它们长生不死！我简直是救命恩人！"

# game/script.rpy:359
translate schinese case1_b156934a:

    # eiki "The floor is yours, Junior Judge. Press her for details."
    eiki "交给你了，见习法官。追问她细节吧。"

# game/script.rpy:360
translate schinese case1_56bac375:

    # eiki "When a statement fails, object. You have [spirit_word!t] magatama of spirit. Spend them wisely."
    eiki "发现陈述站不住脚就提出异议。你有[spirit_word!t]枚灵力勾玉。好好使用。"

# game/script.rpy:374
translate schinese case1_cross_2726332a:

    # eiki "Again. From the top. Slower, for everyone's sake."
    eiki "再来。从头开始。为了大家，慢一点。"

# game/script.rpy:385
translate schinese case1_breakthrough_00d679e4:

    # you "Plenty of frogs freeze in winter and thaw in spring. They manage it without you."
    you "很多青蛙冬天冻住，春天解冻。没有你，它们也照样能做到。"

# game/script.rpy:386
translate schinese case1_breakthrough_f69b5607:

    # you "The ice didn't save them. The noon sun thawed them. You just happened to be first."
    you "不是冰救了它们，是中午的太阳把它们晒化了。你只是碰巧在前面。"

# game/script.rpy:389
translate schinese case1_breakthrough_114e8904:

    # cirno "B-but the ice came first! First means it did it!"
    cirno "可、可是冰在前面！在前面就是它干的！"

# game/script.rpy:393
translate schinese case1_breakthrough_adeb5213:

    # eiki "Post hoc, ergo propter hoc. \"After this, therefore because of this.\""
    eiki "Post hoc, ergo propter hoc。“在此之后，因此由此造成”。"

# game/script.rpy:394
translate schinese case1_breakthrough_7f1940e4:

    # eiki "Two events line up in time, and you crown the first one the cause."
    eiki "两件事在时间上排在一起，你就把先发生的那件封为原因。"

# game/script.rpy:395
translate schinese case1_breakthrough_bed96fcf:

    # eiki "The rooster crows, then the sun rises. Nobody thanks the rooster."
    eiki "公鸡打鸣，然后太阳升起。没人会去感谢公鸡。"

# game/script.rpy:402
translate schinese case1_breakthrough_b3416c7f:

    # eiki "Defendant Cirno. This court finds you..."
    eiki "被告琪露诺。本庭判决你……"

# game/script.rpy:413
translate schinese case1_breakthrough_12f0faee:

    # eiki "Sentence: one hundred hours explaining causation to the frogs."
    eiki "判决：花一百个小时向青蛙们解释因果关系。"

# game/script.rpy:416
translate schinese case1_breakthrough_7988cf39:

    # cirno "Can I freeze them while I explain?"
    cirno "我可以边解释边冻它们吗？"

# game/script.rpy:419
translate schinese case1_breakthrough_6063f5e0:

    # eiki "Bailiff."
    eiki "法警。"

# game/script.rpy:420
translate schinese case1_breakthrough_ce8461be:

    # komachi "On it, boss."
    komachi "这就去，四季大人。"

# game/script.rpy:432
translate schinese case1_breakthrough_18f47a5b:

    # eiki "...I said escort."
    eiki "……我说的是护送。"

# game/script.rpy:433
translate schinese case1_breakthrough_8b477ea6:

    # komachi "She's escorted. Very far."
    komachi "护送了。送得很远。"

# game/script.rpy:434
translate schinese case1_breakthrough_8d952d11:

    # eiki "Court is adjourned. Adequate work, Junior Judge."
    eiki "退庭。干得还行，见习法官。"

translate schinese strings:

    # game/script.rpy:177
    old "False Cause"
    new "错误归因"

    # game/script.rpy:177
    old "(Correlation ≠ Causation)"
    new "（相关≠因果）"

    # game/script.rpy:177
    old "Assuming that because B happened after A, A must have caused B."
    new "认为B发生在A之后，所以一定是A导致了B。"

    # game/script.rpy:184
    old "Ad Hominem"
    new "人身攻击"

    # game/script.rpy:184
    old "(Attack the Speaker)"
    new "（攻击说话的人）"

    # game/script.rpy:184
    old "Rejecting a claim by attacking the person who made it."
    new "通过攻击提出主张的人来否定这个主张。"

    # game/script.rpy:191
    old "Slippery Slope"
    new "滑坡谬误"

    # game/script.rpy:191
    old "(Chain of Doom)"
    new "（灾难连锁）"

    # game/script.rpy:191
    old "Insisting one small step must snowball into disaster, with no proof."
    new "毫无证据地坚称一小步必然会滚成一场大灾难。"

    # game/script.rpy:198
    old "Tu Quoque"
    new "你也一样"

    # game/script.rpy:198
    old "(You Too!)"
    new "（你也一样！）"

    # game/script.rpy:198
    old "Excusing a wrong by pointing out that someone else does it too."
    new "以别人也这么做来为错误开脱。"

    # game/script.rpy:205
    old "False Dilemma"
    new "虚假两难"

    # game/script.rpy:205
    old "(Only Two Doors)"
    new "（只有两扇门）"

    # game/script.rpy:205
    old "Offering two options as the only ones, when others exist."
    new "明明还有其他选项，却只摆出两个，说只有这两个。"

    # game/script.rpy:212
    old "Appeal to Authority"
    new "诉诸权威"

    # game/script.rpy:212
    old "(Because They Said So)"
    new "（因为大人物说过）"

    # game/script.rpy:212
    old "Treating a famous name as proof instead of checking the evidence."
    new "不去检验证据，而把一个有名的名字当成证明。"

    # game/script.rpy:219
    old "Circular Reasoning"
    new "循环论证"

    # game/script.rpy:219
    old "(Begging the Question)"
    new "（窃取论题）"

    # game/script.rpy:219
    old "Using the conclusion as its own reason, so the argument proves nothing."
    new "把结论本身当作理由，因此这个论证什么也没证明。"

    # game/script.rpy:227
    old "Frog Census"
    new "青蛙普查表"

    # game/script.rpy:227
    old "Twenty frogs, all accounted for. All mildly annoyed."
    new "二十只青蛙，全部在册。全都有点不高兴。"

    # game/script.rpy:229
    old "Misty Lake Weather Log"
    new "雾之湖气象记录"

    # game/script.rpy:229
    old "Clear skies all day. Thirty-one degrees by noon."
    new "全天晴朗。中午达到三十一度。"

    # game/script.rpy:231
    old "Cirno's Ice"
    new "琪露诺的冰"

    # game/script.rpy:231
    old "Ordinary ice. Melts in the sun, like all ice."
    new "普通的冰。跟所有的冰一样，晒太阳就会化。"

    # game/script.rpy:234
    old "The Frog Incident"
    new "青蛙事件"

    # game/script.rpy:234
    old "I froze twenty frogs by Misty Lake this morning!"
    new "今天早上，我在雾之湖冻住了二十只青蛙！"

    # game/script.rpy:234
    old "She froze twenty frogs. We have sworn statements from the frogs. That part is simply true."
    new "她冻住了二十只青蛙。我们有青蛙们的宣誓证词。这部分就是事实。"

    # game/script.rpy:234
    old "Every single one of them thawed out by noon and hopped away!"
    new "每一只到中午都解冻了，蹦蹦跳跳地跑掉了！"

    # game/script.rpy:234
    old "Frogs thawing in the noon sun is a fact, not a fallacy. Object to reasoning, not weather."
    new "青蛙被中午的太阳晒化是事实，不是谬误。要对推理提出异议，而不是天气。"

    # game/script.rpy:234
    old "Therefore, freezing frogs makes them immortal! I'm basically a lifesaver!"
    new "所以，冻住青蛙能让它们长生不死！我简直是救命恩人！"

    # game/script.rpy:234
    old "Ad Hominem means attacking the speaker. Nobody insulted anyone. Except, arguably, the frogs."
    new "人身攻击指的是攻击说话的人。没有人侮辱任何人。青蛙可能除外。"

    # game/script.rpy:234
    old "Slippery Slope predicts a chain of disasters. She predicted one immortal frog. Look again."
    new "滑坡谬误预言的是一连串灾难。她预言的只是一只不死的青蛙。再看看。"

    # game/script.rpy:234
    old "She isn't excusing herself by pointing at anyone. She's crediting the ice with the sun's work."
    new "她没有指着谁为自己开脱。她把太阳的功劳算到了冰头上。"

    # game/script.rpy:234
    old "Nobody offered two doors. She saw two events in a row and crowned the first one."
    new "没人给出两扇门。她看到两件事接连发生，就把先发生的那件封为原因。"

    # game/script.rpy:234
    old "She cites no famous name. Only herself, which is not the same thing."
    new "她没引用任何有名的名字。只有她自己，那可不是一回事。"

    # game/script.rpy:234
    old "Her logic doesn't loop back on itself. It just trips over the word \"then.\""
    new "她的逻辑没有绕回自身。只是被“然后”这个词绊倒了。"

    # game/script.rpy:234
    old "That doesn't explain the thawing. What actually warmed those frogs?"
    new "那解释不了解冻的原因。到底是什么让青蛙暖和起来的？"

    # game/script.rpy:345
    old "WITNESS TESTIMONY"
    new "证人证词"

    # game/script.rpy:349
    old "TESTIMONY"
    new "证词"

    # game/script.rpy:406
    old "GUILTY"
    new "有罪"

