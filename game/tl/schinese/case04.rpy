# game/case04.rpy:58
translate schinese press_reisen_1_5456b505:

    # you "What exactly is in the tonic?"
    you "这药里到底放了什么？"

# game/case04.rpy:60
translate schinese press_reisen_1_7520912f:

    # reisen "Moon herbs, honey, and something Master told me not to ask about."
    reisen "月之药草、蜂蜜，还有师父叫我别问的某种东西。"

# game/case04.rpy:64
translate schinese press_reisen_2_19e2a292:

    # you "Is hearing colours a known side effect?"
    you "听见颜色是已知的副作用吗？"

# game/case04.rpy:66
translate schinese press_reisen_2_2b47b1b1:

    # reisen "Define \"known.\" On the moon, we... never mind. No. It isn't."
    reisen "看你怎么定义“已知”。在月球上……算了。不，不是。"

# game/case04.rpy:70
translate schinese press_reisen_3_8769889d:

    # you "Cleared by whom, exactly?"
    you "到底是谁批准的？"

# game/case04.rpy:72
translate schinese press_reisen_3_a123ee9b:

    # reisen "By the greatest pharmacist in Gensokyo! My master!"
    reisen "幻想乡最伟大的药师！我的师父！"

# game/case04.rpy:73
translate schinese press_reisen_3_c707d443:

    # reisen "Add that to my testimony. It settles everything."
    reisen "把这条加进我的证词。这就能说明一切。"

# game/case04.rpy:77
translate schinese press_reisen_4_1edb4caf:

    # you "Did Eirin actually test the tonic?"
    you "永琳真的测试过这种药吗？"

# game/case04.rpy:79
translate schinese press_reisen_4_46eb3347:

    # reisen "She didn't need to. She's a genius. Geniuses just know things."
    reisen "不需要。她是天才。天才就是知道。"

# game/case04.rpy:81
translate schinese press_reisen_4_ffbb2967:

    # eiki "Her teacher's reputation is doing all of her arguing for her."
    eiki "她师父的名声在替她做全部的辩论。"

# game/case04.rpy:92
translate schinese case4_c1fe0fe8:

    # eiki "Order. The Higan Court of Logic is in session. Last case of the day."
    eiki "肃静。彼岸逻辑法庭现在开庭。今天的最后一案。"

# game/case04.rpy:94
translate schinese case4_0d42250e:

    # eiki "Komachi."
    eiki "小町。"

# game/case04.rpy:95
translate schinese case4_b2edef9d:

    # komachi "Defendant's here, boss. Brought free samples."
    komachi "被告到了，四季大人。还带了免费试用品。"

# game/case04.rpy:96
translate schinese case4_ac34ad81:

    # eiki "Confiscate them."
    eiki "没收。"

# game/case04.rpy:97
translate schinese case4_4da474d4:

    # komachi "Already drank one. Is purple supposed to sound like that?"
    komachi "我已经喝了一瓶。紫色听起来是这样的吗？"

# game/case04.rpy:100
translate schinese case4_eec6d569:

    # reisen "Reisen Udongein Inaba, assistant to Eientei's pharmacist. This is all a misunderstanding."
    reisen "铃仙·优昙华院·因幡，永远亭药师的助手。这全是误会。"

# game/case04.rpy:103
translate schinese case4_b910979b:

    # eiki "The charge: selling an untested tonic in the Human Village."
    eiki "罪名：在人类村落出售未经测试的药物。"

# game/case04.rpy:106
translate schinese case4_369229c7:

    # reisen "It's tested! Well. It's approved. By someone very qualified."
    reisen "测试过了！呃，是批准过了。由一位非常有资格的人。"

# game/case04.rpy:110
translate schinese case4_55ac6728:

    # eiki "Junior Judge. Respect your elders. Respect experts."
    eiki "见习法官。尊重长辈，尊重专家。"

# game/case04.rpy:111
translate schinese case4_67312618:

    # eiki "But respect is not evidence. Remember which one you are weighing."
    eiki "但尊重不是证据。记住你在称量的是哪一个。"

# game/case04.rpy:127
translate schinese case4_5baa0096:

    # reisen_t "I sold the tonic in the Human Village yesterday. Everyone paid in full."
    reisen_t "我昨天在人类村落卖了药。大家都付了全款。"

# game/case04.rpy:128
translate schinese case4_0f5a1a98:

    # reisen_t "This morning, three customers said they could hear colours. Mostly blue."
    reisen_t "今天早上，有三位顾客说他们能听见颜色。主要是蓝色。"

# game/case04.rpy:129
translate schinese case4_7f7e4905:

    # reisen_t "But the tonic was cleared before I sold a single bottle."
    reisen_t "可是，我卖出第一瓶之前，这药就已经被批准了。"

# game/case04.rpy:133
translate schinese case4_99b4e411:

    # eiki "The floor is yours, Junior Judge. Do not drink anything she offers you."
    eiki "交给你了，见习法官。她给你什么都别喝。"

# game/case04.rpy:147
translate schinese case4_cross_35e740a1:

    # eiki "Again. And Komachi, put the samples down."
    eiki "再来。还有小町，把试用品放下。"

# game/case04.rpy:158
translate schinese case4_breakthrough_d89358d9:

    # you "Eirin's genius doesn't change what happened to your customers."
    you "永琳再天才，也改变不了你的顾客身上发生的事。"

# game/case04.rpy:159
translate schinese case4_breakthrough_cd4d5d14:

    # you "Three villagers hear colours. A reputation can't outvote three witnesses."
    you "三个村民听得见颜色。名声可压不过三位证人。"

# game/case04.rpy:162
translate schinese case4_breakthrough_6e1b807b:

    # reisen "B-but Master is never wrong! ...She's rarely wrong. She's wrong sometimes."
    reisen "可、可是师父从来不会错！……很少会错。偶尔会错。"

# game/case04.rpy:166
translate schinese case4_breakthrough_b62eef67:

    # eiki "An appeal to authority. A famous name is not a test result."
    eiki "诉诸权威。有名的名字不是测试结果。"

# game/case04.rpy:167
translate schinese case4_breakthrough_30d9ca52:

    # eiki "Experts deserve a hearing. They do not deserve a free pass."
    eiki "专家值得一听，但不该被免检放行。"

# game/case04.rpy:174
translate schinese case4_breakthrough_02f0da17:

    # eiki "Defendant Reisen Udongein Inaba. This court finds you..."
    eiki "被告铃仙·优昙华院·因幡。本庭判决你……"

# game/case04.rpy:185
translate schinese case4_breakthrough_f8ed3269:

    # eiki "Sentence: recall every bottle, and bring this court a written test report. Signed."
    eiki "判决：召回全部药品，并向本庭提交签名的测试报告。"

# game/case04.rpy:188
translate schinese case4_breakthrough_3b6bf734:

    # reisen "Can Master sign it?"
    reisen "可以让师父签吗？"

# game/case04.rpy:191
translate schinese case4_breakthrough_eb7b6c39:

    # eiki "Only if she runs the test first. Bailiff."
    eiki "只要她先做测试。法警。"

# game/case04.rpy:192
translate schinese case4_breakthrough_ce8461be:

    # komachi "On it, boss."
    komachi "这就去，四季大人。"

# game/case04.rpy:204
translate schinese case4_breakthrough_fa8c9b2e:

    # eiki "I keep saying \"escort.\""
    eiki "我一直说的是“护送”。"

# game/case04.rpy:205
translate schinese case4_breakthrough_c3175236:

    # komachi "And I keep escorting, boss. Very efficiently."
    komachi "我一直在护送啊，四季大人。效率超高。"

# game/case04.rpy:206
translate schinese case4_breakthrough_71592ec1:

    # komachi "Oh, boss. A fairy at Misty Lake is selling frozen pudding. Two yen a scoop."
    komachi "对了，四季大人。雾之湖有个妖精在卖冰冻布丁。两円一勺。"

# game/case04.rpy:207
translate schinese case4_breakthrough_bbc0d58b:

    # eiki "Irrelevant. The pudding case is closed. I closed it myself."
    eiki "无关。布丁案已经结案了。是我亲自结的。"

# game/case04.rpy:208
translate schinese case4_breakthrough_7193588e:

    # komachi "Just saying. The cups have a little bat on them."
    komachi "我就随口一提。杯子上印着一只小蝙蝠。"

# game/case04.rpy:209
translate schinese case4_breakthrough_082411fc:

    # eiki "Komachi. A closed case stays closed."
    eiki "小町。结了的案子就是结了。"

# game/case04.rpy:210
translate schinese case4_breakthrough_c739c1fe:

    # eiki "That clears today's docket. Junior Judge, your work was... acceptable."
    eiki "今天的案件到此为止。见习法官，你的表现……还算过得去。"

# game/case04.rpy:211
translate schinese case4_breakthrough_7e4a9829:

    # komachi "That's her highest praise, by the way."
    komachi "顺带一提，这是她的最高评价。"

# game/case04.rpy:212
translate schinese case4_breakthrough_0d42250e:

    # eiki "Komachi."
    eiki "小町。"

# game/case04.rpy:213
translate schinese case4_breakthrough_bd395515:

    # komachi "Escorting myself out."
    komachi "我把自己护送出去。"

translate schinese strings:

    # game/case04.rpy:10
    old "Miracle Tonic"
    new "奇迹药剂"

    # game/case04.rpy:10
    old "Label: \"Perfectly safe! —Eirin.\" Smells faintly of blueberries."
    new "标签：“绝对安全！——永琳”。隐约有蓝莓味。"

    # game/case04.rpy:12
    old "Eirin's Diploma"
    new "永琳的毕业证书"

    # game/case04.rpy:12
    old "Lunar Academy of Medicine. Top of her class, ten thousand years running."
    new "月之医学院。连续一万年第一名。"

    # game/case04.rpy:14
    old "Eientei Lab Notebook"
    new "永远亭实验笔记"

    # game/case04.rpy:14
    old "\"Miracle Tonic. Tests run: none yet. Selling anyway (Reisen).\""
    new "“奇迹药剂。已做测试：暂无。先卖着再说（铃仙）。”"

    # game/case04.rpy:17
    old "Eientei's Miracle Tonic"
    new "永远亭的奇迹药剂"

    # game/case04.rpy:17
    old "I sold the tonic in the Human Village yesterday. Everyone paid in full."
    new "我昨天在人类村落卖了药。大家都付了全款。"

    # game/case04.rpy:17
    old "A sales record is not an argument. Though the receipts are very neat."
    new "销售记录不是论证。虽然收据很整齐。"

    # game/case04.rpy:17
    old "This morning, three customers said they could hear colours. Mostly blue."
    new "今天早上，有三位顾客说他们能听见颜色。主要是蓝色。"

    # game/case04.rpy:17
    old "That is a symptom, not a syllogism. Find the place where she reasons."
    new "那是症状，不是推理。找出她进行推论的地方。"

    # game/case04.rpy:17
    old "But the tonic was cleared before I sold a single bottle."
    new "可是，我卖出第一瓶之前，这药就已经被批准了。"

    # game/case04.rpy:17
    old "Cleared by whom? Press her before you object."
    new "谁批准的？提出异议之前先追问她。"

    # game/case04.rpy:17
    old "Master Eirin says it's perfectly safe. So it can't be the tonic."
    new "永琳师父说这药绝对安全。所以不可能是药的问题。"

    # game/case04.rpy:17
    old "That's the mirror image. Ad Hominem rejects a claim because of who made it. She's accepting one."
    new "那正好相反。人身攻击是因为说话的人而拒绝一个主张。她是在接受一个主张。"

    # game/case04.rpy:17
    old "Nobody is offering two doors here. She's leaning on one very famous name."
    new "这里没人给出两扇门。她是在倚靠一个非常有名的名字。"

    # game/case04.rpy:17
    old "Order isn't her mistake. She's treating a name as if it were a test."
    new "先后顺序不是她的错误。她把一个名字当成了测试结果。"

    # game/case04.rpy:17
    old "She isn't pointing at anyone else's sins. She's hiding behind her teacher's title."
    new "她没有指出别人的过错。她是躲在师父的头衔后面。"

    # game/case04.rpy:17
    old "No chain of disasters predicted. Just one reputation, doing all the work."
    new "没有预言一连串的灾难。只是一个名声包揽了全部工作。"

    # game/case04.rpy:17
    old "That's a reputation, not a result. Show whether anyone actually tested it."
    new "那是名声，不是结果。拿出有没有人真正测试过的证据。"

