# game/case10.rpy:62
translate schinese mokou_flare_2a7742da:

    # komachi "[flare!t]"
    komachi "[flare!t]"

# game/case10.rpy:67
translate schinese press_mokou_1_431a8d2d:

    # you "Hardly struggled?"
    you "几乎没挣扎？"

# game/case10.rpy:69
translate schinese press_mokou_1_5fd43467:

    # mokou "She laughed the whole way. Then she handed me this."
    mokou "她一路都在笑。然后把这个交给了我。"

# game/case10.rpy:72
translate schinese press_mokou_1_6560db77:

    # eiki "...Laughed."
    eiki "……笑着。"

# game/case10.rpy:76
translate schinese press_mokou_2_585f0b40:

    # you "What does a thousand-year-old feud have to do with yesterday?"
    you "一千年前的恩怨和昨天的事有什么关系？"

# game/case10.rpy:78
translate schinese press_mokou_2_24fa6820:

    # mokou "Everything! ...Mostly. Some of it."
    mokou "全都有关系！……大部分。有一些。"

# game/case10.rpy:80
translate schinese press_mokou_2_a72bf289:

    # eiki "None of it."
    eiki "毫无关系。"

# game/case10.rpy:88
translate schinese case10_e4d50492:

    # komachi "Boss. They're back. Both of them. It's dinner time."
    komachi "四季大人。她们回来了。两个都回来了。正好晚饭时间。"

# game/case10.rpy:89
translate schinese case10_82fc8a19:

    # eiki "As predicted."
    eiki "不出所料。"

# game/case10.rpy:93
translate schinese case10_cf5069c6:

    # eiki "A short session. The charge is kidnapping, and the defendant is hungry."
    eiki "简短的庭审。罪名是绑架，而被告饿了。"

# game/case10.rpy:97
translate schinese case10_82118b5e:

    # mokou "Fujiwara no Mokou. Let's make it quick. There's a pot of dishes waiting for somebody."
    mokou "藤原妹红。快点结束吧。有一堆碗在等着某人去洗。"

# game/case10.rpy:100
translate schinese case10_82384f8f:

    # eiki "The charge: carrying the defendant of Case 09 out of this court. By force. On fire."
    eiki "罪名：把第九案的被告带出了本庭。强行。还着着火。"

# game/case10.rpy:101
translate schinese case10_a225a076:

    # kaguya "I'm a witness too, you know. Nobody asked me."
    kaguya "我也是证人啊。只是没人问我。"

# game/case10.rpy:102
translate schinese case10_a5ce8077:

    # eiki "Later."
    eiki "等会儿。"

# game/case10.rpy:105
translate schinese case10_9fda1bf8:

    # eiki "Junior Judge. A bad argument is not the same as a false conclusion."
    eiki "见习法官。糟糕的论证不等于错误的结论。"

# game/case10.rpy:106
translate schinese case10_0d0ea5e6:

    # eiki "Today, catch the fallacy. Then ask whether the answer was right anyway."
    eiki "今天，先识破谬误。然后再问，答案是否依然正确。"

# game/case10.rpy:122
translate schinese case10_8e41f65c:

    # mokou_t "Kidnapping? I carried her out the door. She hardly struggled."
    mokou_t "绑架？我只是把她扛出了门。她几乎没挣扎。"

# game/case10.rpy:123
translate schinese case10_a1aec528:

    # mokou_t "And what about what her family did to mine, a thousand years ago? Ask about that."
    mokou_t "倒不如说说，一千年前她家对我家做了什么？问问那个吧。"

# game/case10.rpy:127
translate schinese case10_9c2fe25a:

    # eiki "Quickly, Junior Judge. Before she sets anything else alight."
    eiki "快点，见习法官。趁她还没点着别的东西。"

# game/case10.rpy:141
translate schinese case10_cross_511a86a4:

    # eiki "Again. Komachi, fetch a bucket."
    eiki "再来一次。小町，去拿个水桶。"

# game/case10.rpy:152
translate schinese case10_breakthrough_a7985c01:

    # you "A thousand-year-old feud says nothing about yesterday. That's a red herring."
    you "一千年前的恩怨说明不了昨天的事。那是红鲱鱼谬误。"

# game/case10.rpy:153
translate schinese case10_breakthrough_7fd59251:

    # you "But this letter answers the question you dodged. Kaguya asked you to come and get her."
    you "但这封信回答了你回避的问题。是辉夜请你来接她的。"

# game/case10.rpy:156
translate schinese case10_breakthrough_7fcb90a2:

    # mokou "...You read her letter? Out loud? In court?"
    mokou "……你读了她的信？念出声？在法庭上？"

# game/case10.rpy:160
translate schinese case10_breakthrough_7df6c67b:

    # eiki "A red herring. Drag a smelly fish across the trail, and the hounds forget the fox."
    eiki "红鲱鱼谬误。把一条臭鱼拖过足迹，猎犬就会忘了狐狸。"

# game/case10.rpy:161
translate schinese case10_breakthrough_4cacd0f7:

    # eiki "Her reasoning was a red herring. Her conclusion, however, was correct."
    eiki "她的推理是一条红鲱鱼。但她的结论却是对的。"

# game/case10.rpy:162
translate schinese case10_breakthrough_fc11740a:

    # eiki "No one can kidnap a princess who wrote the invitation."
    eiki "没有人能绑架一个亲自写了邀请函的公主。"

# game/case10.rpy:169
translate schinese case10_breakthrough_5cb747ef:

    # eiki "Defendant Fujiwara no Mokou. On the charge of kidnapping, this court finds you..."
    eiki "被告藤原妹红。就绑架罪，本庭判决你……"

# game/case10.rpy:180
translate schinese case10_breakthrough_2f245723:

    # eiki "On the matter of the bench, however: you will build this court a new one."
    eiki "不过关于证人席，你要给本庭做一个新的。"

# game/case10.rpy:183
translate schinese case10_breakthrough_604c2a11:

    # mokou "Fine. I'm good with wood. Better with fire."
    mokou "行。我擅长木工。更擅长放火。"

# game/case10.rpy:187
translate schinese case10_breakthrough_d32aabaa:

    # kaguya "For the record, I won. She's doing the dishes."
    kaguya "郑重声明，我赢了。洗碗的是她。"

# game/case10.rpy:188
translate schinese case10_breakthrough_b6692432:

    # mokou "You did NOT win."
    mokou "你才没赢！"

# game/case10.rpy:191
translate schinese case10_breakthrough_cc352d5c:

    # komachi "Bailiff time, boss? ...Wait. She was acquitted."
    komachi "该法警出场了吗，四季大人？……等等。她被判无罪了。"

# game/case10.rpy:192
translate schinese case10_breakthrough_c0fbcb37:

    # eiki "She was."
    eiki "是的。"

# game/case10.rpy:193
translate schinese case10_breakthrough_0ba44c4b:

    # komachi "Can I throw someone anyway? It's a habit."
    komachi "那我还能扔个人吗？习惯了。"

# game/case10.rpy:194
translate schinese case10_breakthrough_6d40e61c:

    # eiki "No."
    eiki "不行。"

# game/case10.rpy:196
translate schinese case10_breakthrough_4b58e218:

    # komachi "Boss. The Bunbunmaru printed this before the trial even started."
    komachi "四季大人。文文。新闻在审判开始前就印了这个。"

# game/case10.rpy:197
translate schinese case10_breakthrough_81c6b336:

    # eiki "\"PRINCESS KIDNAPPED IN COURT.\" One blurry photo, and not one word from the princess."
    eiki "“公主在法庭上被绑架。”一张模糊的照片，公主的话却一句都没有。"

# game/case10.rpy:198
translate schinese case10_breakthrough_1ea22463:

    # eiki "That tengu has written about every case on this docket."
    eiki "那个天狗把这份案卷里的每一件案子都写过了。"

# game/case10.rpy:199
translate schinese case10_breakthrough_100a0b7e:

    # eiki "Komachi. Summon her. Tomorrow, she writes from the witness stand."
    eiki "小町。传唤她。明天让她在证人席上写。"

# game/case10.rpy:200
translate schinese case10_breakthrough_ce8461be:

    # komachi "On it, boss."
    komachi "这就去，四季大人。"

translate schinese strings:

    # game/case10.rpy:11
    old "Scorched Bench"
    new "烧焦的证人席"

    # game/case10.rpy:11
    old "The witness bench from Case 09. Still smoking. Smells faintly of bamboo."
    new "第九案的证人席。还在冒烟。隐约有竹子的气味。"

    # game/case10.rpy:13
    old "Bunbunmaru Extra"
    new "文文。新闻号外"

    # game/case10.rpy:13
    old "\"PRINCESS KIDNAPPED IN COURT!\" One blurry photo. Printed before it happened."
    new "“公主在法庭上被绑架！”一张模糊的照片。在事情发生前就印好了。"

    # game/case10.rpy:15
    old "Kaguya's Letter"
    new "辉夜的信"

    # game/case10.rpy:15
    old "\"Mokou: come and get me after my trial. Loser does the dishes. —K\""
    new "“妹红：我的审判结束后来接我。输的人洗碗。——辉”"

    # game/case10.rpy:18
    old "Custody"
    new "看管"

    # game/case10.rpy:18
    old "Kidnapping? I carried her out the door. She hardly struggled."
    new "绑架？我只是把她扛出了门。她几乎没挣扎。"

    # game/case10.rpy:18
    old "Carrying someone out is the charge, not a fallacy. Find where she argues."
    new "把人扛出去是罪名，不是谬误。找出她在论证的地方。"

    # game/case10.rpy:18
    old "And what about what her family did to mine, a thousand years ago? Ask about that."
    new "倒不如说说，一千年前她家对我家做了什么？问问那个吧。"

    # game/case10.rpy:18
    old "Close. But she isn't saying Kaguya does it too. She's leaving the question behind entirely."
    new "接近了。但她没说辉夜也这么做。她是把问题整个丢在了一边。"

    # game/case10.rpy:18
    old "She isn't attacking Kaguya to refute a claim. She's leading the court away from the question."
    new "她不是为了反驳某个主张而攻击辉夜。她是在把法庭引离问题。"

    # game/case10.rpy:18
    old "Nobody's words are twisted. The question is simply abandoned."
    new "没有人的话被歪曲。问题只是被丢下了。"

    # game/case10.rpy:18
    old "No either-or. Just a thousand-year-old fish, dragged across the trail."
    new "没有非此即彼。只是一条千年老鱼被拖过了足迹。"

    # game/case10.rpy:18
    old "No circle. Her answer is about something else altogether."
    new "没有循环。她的回答完全是关于别的事。"

    # game/case10.rpy:18
    old "That doesn't answer the question she dodged. Did Kaguya go against her will?"
    new "这回答不了她回避的问题。辉夜是被迫离开的吗？"

    # game/case10.rpy:49
    old "Boss, the bench is on fire again."
    new "四季大人，证人席又着火了。"

    # game/case10.rpy:49
    old "That was the railing, boss. Was."
    new "刚才那是栏杆，四季大人。曾经是。"

    # game/case10.rpy:49
    old "Boss, your hat is fine. Mostly."
    new "四季大人，您的帽子没事。大部分没事。"

