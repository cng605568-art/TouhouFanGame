# game/case03.rpy:55
translate schinese press_sakuya_1_8c0d2807:

    # you "How can you be certain of the time?"
    you "你怎么能确定时间？"

# game/case03.rpy:57
translate schinese press_sakuya_1_fd04fbb6:

    # sakuya "I stop it every day. I always know exactly where I left it."
    sakuya "我每天都会停止时间。停在哪里，我总是记得一清二楚。"

# game/case03.rpy:61
translate schinese press_sakuya_2_0e0c44e6:

    # you "Who else was in the mansion at three?"
    you "三点钟的时候，馆里还有谁？"

# game/case03.rpy:63
translate schinese press_sakuya_2_80be7eb0:

    # sakuya "The mistress, her sister, Patchouli, forty fairy maids, and a certain magician. Uninvited."
    sakuya "大小姐、二小姐、帕秋莉大人、四十个妖精女仆，还有某个魔法使。不请自来的。"

# game/case03.rpy:66
translate schinese press_sakuya_2_dab70885:

    # eiki "...The window again, I assume."
    eiki "……我猜又是窗户。"

# game/case03.rpy:70
translate schinese press_sakuya_3_214b97c5:

    # you "Only two? Which two?"
    you "只有两个人？哪两个？"

# game/case03.rpy:71
translate schinese press_sakuya_3_b6f8bc4d:

    # sakuya "Meiling, and the mistress herself. Who would never."
    sakuya "美铃，还有大小姐本人。大小姐当然不会。"

# game/case03.rpy:72
translate schinese press_sakuya_3_aa1a7464:

    # sakuya "Write that down. All of it."
    sakuya "请记下来。一字不漏。"

# game/case03.rpy:76
translate schinese press_sakuya_4_0b19e49b:

    # you "Why are those the only two suspects?"
    you "为什么嫌疑人只有那两个？"

# game/case03.rpy:78
translate schinese press_sakuya_4_b694cb26:

    # sakuya "Because they're the two I considered. That makes the list complete."
    sakuya "因为我考虑过的就是这两个人。所以名单是完整的。"

# game/case03.rpy:80
translate schinese press_sakuya_4_bd1e7763:

    # eiki "A list is complete when it holds everyone, not when you stop writing."
    eiki "名单完整，是因为所有人都在上面，而不是因为你停笔了。"

# game/case03.rpy:91
translate schinese case3_3af4f096:

    # eiki "Order. The Higan Court of Logic is in session."
    eiki "肃静。彼岸逻辑法庭现在开庭。"

# game/case03.rpy:93
translate schinese case3_3a85d08e:

    # eiki "The defendant, Hong Meiling, stands accused of eating the mistress's pudding."
    eiki "被告红美铃，被控吃掉了大小姐的布丁。"

# game/case03.rpy:94
translate schinese case3_5b7a7cf9:

    # komachi "Defendant's asleep at the gate, boss. Seemed rude to wake her."
    komachi "被告在门口睡着了，四季大人。叫醒她好像不太礼貌。"

# game/case03.rpy:95
translate schinese case3_fcb03c9e:

    # eiki "...We will proceed without her. The witness, please."
    eiki "……那就不等她了。请证人。"

# game/case03.rpy:98
translate schinese case3_86ddeb38:

    # sakuya "Izayoi Sakuya, head maid. I'll be brief. I have a mansion to run."
    sakuya "十六夜咲夜，女仆长。我长话短说，还有整座馆要打理。"

# game/case03.rpy:101
translate schinese case3_10c6eb56:

    # eiki "You accuse your own gatekeeper?"
    eiki "你要控告自家的门卫？"

# game/case03.rpy:104
translate schinese case3_ca5fc8e3:

    # sakuya "I accuse whoever the facts accuse. Today, the facts are very sleepy."
    sakuya "我只控告事实所指的人。今天的事实，看起来很困。"

# game/case03.rpy:108
translate schinese case3_168658ff:

    # eiki "Junior Judge. A tidy witness gives tidy answers."
    eiki "见习法官。整洁的证人会给出整洁的回答。"

# game/case03.rpy:109
translate schinese case3_a615c359:

    # eiki "Tidy is not the same as complete. Listen for what she leaves out."
    eiki "整洁不等于完整。留意她没说出口的部分。"

# game/case03.rpy:125
translate schinese case3_0354f18b:

    # sakuya_t "At three o'clock, the mistress's pudding was in the kitchen. I placed it there myself."
    sakuya_t "三点整，大小姐的布丁在厨房里。是我亲手放的。"

# game/case03.rpy:126
translate schinese case3_b27a2582:

    # sakuya_t "At five past three, the plate was empty. Only the spoon remained."
    sakuya_t "三点零五分，盘子空了。只剩下勺子。"

# game/case03.rpy:127
translate schinese case3_c2f25894:

    # sakuya_t "Only two people could possibly have eaten it."
    sakuya_t "能吃掉它的，只可能是两个人中的一个。"

# game/case03.rpy:131
translate schinese case3_9ed50f72:

    # eiki "Cross-examine, Junior Judge. Quickly. She has already checked her watch twice."
    eiki "交叉询问吧，见习法官。快一点。她已经看了两次表了。"

# game/case03.rpy:145
translate schinese case3_cross_92e93072:

    # eiki "Again. The pudding is not getting any less eaten."
    eiki "再来。布丁也不会因此变得没被吃掉。"

# game/case03.rpy:156
translate schinese case3_breakthrough_1ae3ffaa:

    # you "Your mansion holds dozens of people. You offered the court exactly two."
    you "你的馆里有几十个人。你却只给法庭两个选项。"

# game/case03.rpy:157
translate schinese case3_breakthrough_5e393fa8:

    # you "Fairy maids, the mistress's sister, a certain magician. Any of them could have eaten it."
    you "妖精女仆、二小姐、某个魔法使。谁都可能吃掉它。"

# game/case03.rpy:160
translate schinese case3_breakthrough_1ec5755b:

    # sakuya "...Forty fairy maids. I didn't count the fairy maids."
    sakuya "……四十个妖精女仆。我没把妖精女仆算进去。"

# game/case03.rpy:164
translate schinese case3_breakthrough_062abc7c:

    # eiki "A false dilemma. Two doors painted on a wall, and you are told to pick one."
    eiki "虚假两难。墙上画了两扇门，然后叫你选一扇。"

# game/case03.rpy:165
translate schinese case3_breakthrough_63db6fbe:

    # eiki "When someone offers only two choices, ask who took away the others."
    eiki "当别人只给你两个选项时，问问是谁拿走了其余的。"

# game/case03.rpy:172
translate schinese case3_breakthrough_8c9ba004:

    # eiki "In the matter of Hong Meiling and the vanished pudding, this court finds the defendant..."
    eiki "关于红美铃与消失的布丁一案，本庭判决被告……"

# game/case03.rpy:183
translate schinese case3_breakthrough_8ea0bb4d:

    # eiki "The pudding remains at large."
    eiki "布丁仍然下落不明。"

# game/case03.rpy:186
translate schinese case3_breakthrough_bd62757d:

    # sakuya "I'll find the real culprit. I have all the time in the world. Literally."
    sakuya "真凶我会找出来。我有的是时间。字面意义上的。"

# game/case03.rpy:196
translate schinese case3_breakthrough_3ed88655:

    # komachi "...She does that."
    komachi "……她常这样。"

# game/case03.rpy:197
translate schinese case3_breakthrough_6b25a3b4:

    # eiki "Court is adjourned. Someone wake the defendant and tell her she won."
    eiki "退庭。谁去叫醒被告，告诉她赢了。"

translate schinese strings:

    # game/case03.rpy:8
    old "Empty Plate"
    new "空盘子"

    # game/case03.rpy:8
    old "One spoon, licked clean. No fingerprints, just custard."
    new "一把舔得干干净净的勺子。没有指纹，只有蛋奶。"

    # game/case03.rpy:10
    old "Pudding Recipe"
    new "布丁食谱"

    # game/case03.rpy:10
    old "Eggs, milk, sugar. \"For the mistress only\" piped in caramel."
    new "鸡蛋、牛奶、砂糖。用焦糖写着“大小姐专用”。"

    # game/case03.rpy:12
    old "Mansion Roster, 3 PM"
    new "下午三点的红魔馆名册"

    # game/case03.rpy:12
    old "Present: the mistress, her sister, Patchouli, forty fairy maids, one uninvited magician."
    new "在馆：大小姐、二小姐、帕秋莉、四十个妖精女仆、一个不请自来的魔法使。"

    # game/case03.rpy:15
    old "The Three O'Clock Pudding"
    new "三点钟的布丁"

    # game/case03.rpy:15
    old "At three o'clock, the mistress's pudding was in the kitchen. I placed it there myself."
    new "三点整，大小姐的布丁在厨房里。是我亲手放的。"

    # game/case03.rpy:15
    old "A maid placing a pudding is a fact. A very precise fact. Look further."
    new "女仆放下布丁是事实。非常精确的事实。再往后看。"

    # game/case03.rpy:15
    old "At five past three, the plate was empty. Only the spoon remained."
    new "三点零五分，盘子空了。只剩下勺子。"

    # game/case03.rpy:15
    old "An empty plate is evidence, not reasoning. Object to how she gets from the plate to the culprit."
    new "空盘子是证据，不是推理。针对她如何从盘子推到犯人提出异议。"

    # game/case03.rpy:15
    old "Only two people could possibly have eaten it."
    new "能吃掉它的，只可能是两个人中的一个。"

    # game/case03.rpy:15
    old "She hasn't named them yet. Press her before you object."
    new "她还没说出是哪两个人。提出异议之前先追问她。"

    # game/case03.rpy:15
    old "Either Meiling ate it, or the mistress ate her own pudding. The mistress would never. So: Meiling."
    new "要么是美铃吃的，要么是大小姐吃了自己的布丁。大小姐不会这么做。所以：是美铃。"

    # game/case03.rpy:15
    old "Nothing here mistakes order for cause. The trouble is her menu. Count the dishes."
    new "这里没人把先后当成因果。问题出在她的菜单上。数数有几道菜。"

    # game/case03.rpy:15
    old "Nobody is excusing themselves by pointing elsewhere. Count her suspects. Then count the mansion."
    new "没人靠指责别人来开脱。数数她的嫌疑人，再数数馆里的人。"

    # game/case03.rpy:15
    old "She isn't attacking Meiling's character. She's offering the court only two doors."
    new "她没有攻击美铃的人品。她只给法庭看了两扇门。"

    # game/case03.rpy:15
    old "No chain of disasters here. Just a list of suspects that is suspiciously short."
    new "这里没有一连串的灾难。只有一份短得可疑的嫌疑人名单。"

    # game/case03.rpy:15
    old "That says nothing about who else was home. Ask her who was in the mansion."
    new "那完全说明不了还有谁在家。问问她馆里都有谁。"

    # game/case03.rpy:176
    old "NOT GUILTY"
    new "无罪"

